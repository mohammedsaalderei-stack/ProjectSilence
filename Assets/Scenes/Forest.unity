  m_Script: {fileID: 11500000, guid: d6b85fc7cbda92243b6fb4a10152c380, type: 3}
  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::OverworldMob
  mobId: forest_final
  displayName: Archcantor Vale
  enemyGroup: 2
  enemyBoost: 1
  isBoss: 0
  isFinalBoss: 1
  appearsAfterMob: forest_boss
  introLines:
  - So. The old Maestro's student has finally come, with a little choir of strays.
  - Your teacher lowered his baton before my chord could end. Every voice in Cantoria,
    held forever in one perfect note, and he called it a cage.
  - The Silence is only my chord, waiting to be finished. Stand aside, or become
    part of it.
  - 'Maestro: "Every song needs an ending, Vale. We came to play yours."'
  wanderRadius: 0
  noticeRadius: 5
  giveUpRadius: 10
  walkSpeed: 0
  chaseSpeed: 0
  touchDistance: 1.3125
