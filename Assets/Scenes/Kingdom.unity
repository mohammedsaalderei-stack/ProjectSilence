--- !u!114 &788159083
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 788159080}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 827b4bd3e0001ca4c9bd6317fc8a1d15, type: 3}
  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::NpcTalk
  npcName: Guard Bram
  lines:
  - 'Halt! Past this east gate lies the Forest. Something there swallows every sound:
    birds, wind, even footsteps.'
  - Hollow wolves have already slipped past us. If one catches you, you must fight.
    Sprint with Shift to get away.
  - They say a stone giant, the Hollow Colossus, hums at the heart of the woods.
    Break it and the Silence fades.
  healsParty: 0
  talkRange: 4.4
